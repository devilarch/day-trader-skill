{
  "mcpServers": {
    "zerodha": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.kite.trade/mcp"]
    },
    "zerodha-local": {
      "command": "node",
      "args": ["/path/to/zerodhamcpserver/dist/index.js"],
      "env": {
        "ZERODHA_API_KEY": "YOUR_KITE_API_KEY",
        "ZERODHA_API_SECRET": "YOUR_KITE_API_SECRET"
      }
    }
  }
}
